# ============================================================
#  GridGuard Strands Operations Autopilot — Environment Config
#  Copy this file to .env and fill in values for live mode.
# ============================================================

# ── Demo / Safety ────────────────────────────────────────────
# Set to true  → full mock workflow, zero API calls, zero cost
# Set to false → live LLM calls (requires provider credentials)
MOCK_MODE=true

# ── LLM Provider ─────────────────────────────────────────────
# Options: bedrock | anthropic
# "bedrock"   → uses AWS credentials below
# "anthropic" → uses ANTHROPIC_API_KEY below
STRANDS_PROVIDER=bedrock

# ── AWS / Bedrock ─────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
# Optional: explicit session token for temporary credentials
# AWS_SESSION_TOKEN=YOUR_SESSION_TOKEN

BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0

# ── Live Mode Safeguards & Cost Control ───────────────────────
# Process-level ceiling on live Bedrock calls per session (default: 5)
LIVE_RUN_LIMIT=5
# Maximum output tokens generated per live briefing (default: 600)
LIVE_MAX_OUTPUT_TOKENS=600
# Sampling temperature for deterministic operator briefing (default: 0.2)
LIVE_TEMPERATURE=0.2

# ── Anthropic Direct ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── Application ───────────────────────────────────────────────
LOG_LEVEL=INFO
# Path for the append-only audit log
AUDIT_LOG_PATH=data/audit_log.jsonl
